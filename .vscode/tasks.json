{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Java practice auto-push watcher",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\autopush.ps1"
            ],
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
